<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp"
    android:layout_marginVertical="5dp"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/noticetitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/lato"
            android:textColor="@color/prime"
            android:textStyle="bold"
            android:text="Announcement Title"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/noticedate"
            android:fontFamily="@font/lato"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="5dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:text="Date:"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/noticedate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="9dp"
            android:fontFamily="@font/lato"
            android:textColor="@color/black"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="7dp"
            android:text="2078-02-01"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/noticedesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:layout_marginHorizontal="15dp"
            android:fontFamily="@font/lato"
            android:layout_below="@+id/noticetitle"
            android:text="Here this is just a test announce and notices items model. All notices are displayed in this same format. This a test notice from developer."
            android:textColor="@color/black"
            android:textSize="14sp" />

    </RelativeLayout>


</androidx.cardview.widget.CardView>